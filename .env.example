# ── Database Backend Selection ('mongodb' or 'postgres') ──────────────────────
DATABASE_BACKEND=mongodb

# ── MongoDB Atlas Free Tier Configuration ─────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sign_language_db

# ── Optional: PostgreSQL Database URL (for migration & rollback) ──────────────
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# ── Admin Account Credentials ─────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# ── Flask Session Encryption Key ──────────────────────────────────────────────
SECRET_KEY=generate_a_random_32_byte_hex_string_here
